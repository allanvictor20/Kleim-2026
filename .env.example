# Copy to .env for local development. Never commit .env.
APP_ENV=development
API_BASE_URL=http://localhost:8000
# Browser origins allowed to call the API. Comma-separated; the four dev apps are
# the default. Never "*": the API answers with credentials.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176
DATABASE_URL=postgresql+psycopg://app:app@db:5432/app
REDIS_URL=redis://redis:6379/0
JWT_SECRET=change-me-dev-only
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Integrations (fake adapters in development)
SMS_PROVIDER=console            # console | africastalking
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
PAYMENT_PROVIDER=simulated      # simulated | flutterwave | pesapal
PAYMENT_WEBHOOK_SECRET=
MAPS_PROVIDER=osm               # osm | google
GOOGLE_MAPS_API_KEY=
CLOUDINARY_URL=
FCM_CREDENTIALS_JSON=
SENTRY_DSN=

# Business defaults (overridden by fee_configs in the database)
SELLER_RESPONSE_MINUTES=10
PAYMENT_WINDOW_MINUTES=10
RIDER_OFFER_SECONDS=45
